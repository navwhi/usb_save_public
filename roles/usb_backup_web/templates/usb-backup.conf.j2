# {{ ansible_managed }}
server {
    listen 80 default_server;
{% if usb_backup_web_ipv6 | bool %}
    listen [::]:80 default_server;
{% endif %}
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
{% if usb_backup_web_ipv6 | bool %}
    listen [::]:443 ssl default_server;
{% endif %}
    server_name {{ usb_backup_web_server_name }};

    ssl_certificate     {{ usb_backup_web_tls_dir }}/server.crt;
    ssl_certificate_key {{ usb_backup_web_tls_dir }}/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root {{ usb_backup_web_root }};
    charset utf-8;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Public home page: the user enters the name of their team
    location = / {
        try_files /index.html =404;
    }

    # One block per team (generated by the usb_backup_team role),
    # each protected by the password of that team only.
    include {{ usb_backup_web_teams_conf_dir }}/*.conf;

    location / {
        return 404;
    }
}
