# {{ ansible_managed }}
# Team {{ team_name }}: only the user of this team is listed in its htpasswd file.
location = /{{ team_name }} {
    return 301 /{{ team_name }}/;
}

location /{{ team_name }}/ {
    root {{ usb_backup_teams_dir }};

    auth_basic "USB backups - team {{ team_name }}";
    auth_basic_user_file {{ usb_backup_team_htpasswd }};

    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    # Files are always downloaded, never rendered by the browser
    types { }
    default_type application/octet-stream;

    # A symbolic link cannot point to the files of another team
    disable_symlinks if_not_owner;

    # Hide the temporary finalization folders
    location ~ /\. {
        return 404;
    }
}
